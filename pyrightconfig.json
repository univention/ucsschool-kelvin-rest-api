{
  "venvPath": ".",
  "pythonVersion": "3.11",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "appcenter/tests/stubs",
    "build_docs.py"
  ],
  "reportImplicitStringConcatenation": "none",
  "reportUnusedCallResult": "none",
  "executionEnvironments": [
    {
      "root": "kelvin-api/tests",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "ucsschool-objects/tests",
      "extraPaths": ["ucsschool-objects"],
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "kelvin-connector/tests",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "ucs-school-import/tests",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "appcenter/tests",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "ucs-school-lib/modules/ucsschool/lib/tests",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "ucs-test-ucsschool-kelvin",
      "reportAny": "hint",
      "reportExplicitAny": "hint",
      "reportUnknownLambdaType": "hint",
      "reportUnusedParameter": "hint",
      "reportUnknownArgumentType": "hint",
      "reportUnknownMemberType": "hint",
      "reportUnknownVariableType": "hint",
      "reportUnknownParameterType": "hint",
      "reportMissingParameterType": "hint"
    },
    {
      "root": "."
    }
  ]
}
