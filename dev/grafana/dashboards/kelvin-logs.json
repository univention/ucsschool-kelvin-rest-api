{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Kelvin logs",
  "uid": "kelvin-logs",
  "tags": ["kelvin", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Log records by level (records/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": { "drawStyle": "line", "fillOpacity": 40, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kelvin_log_records_total{service_name=\"kelvin-api\"}[1m])) by (level)",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Warnings / errors in the last 10 min",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(kelvin_log_records_total{service_name=\"kelvin-api\", level=~\"WARNING|ERROR|CRITICAL\"}[10m])) by (level)",
          "legendFormat": "{{level}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Warnings+ by component (records/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kelvin_log_records_total{service_name=\"kelvin-api\", level=~\"WARNING|ERROR|CRITICAL\"}[5m])) by (component)",
          "legendFormat": "{{component}}"
        }
      ]
    }
  ]
}
